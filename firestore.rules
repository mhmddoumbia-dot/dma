rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Annuaire public e-mail -> UID Firebase, nécessaire pour inviter quelqu'un par
    // e-mail avant même qu'il ait un jour ouvert l'application sur son propre appareil.
    match /usersByEmail/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.lower() == email;
    }

    // Un projet n'est lisible/modifiable que par ses membres (UID Firebase présents
    // dans memberFirebaseUids). La création exige que le créateur s'y inclue lui-même.
    match /projects/{projectId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.memberFirebaseUids;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberFirebaseUids;

      match /members/{memberId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberFirebaseUids;
      }
    }
  }
}
